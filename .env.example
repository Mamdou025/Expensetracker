# ─────────────────────────────────────────────────
#  exptrackr — Local Development Environment
#  Copy this file to .env and fill in the values.
#  Never commit .env to version control.
# ─────────────────────────────────────────────────

# ── REQUIRED ──────────────────────────────────────

# PostgreSQL connection string.
# Used by Server/auth.js for user accounts and express-session storage.
# With docker-compose this is pre-set; for manual setup use your own PG URL.
DATABASE_URL=postgresql://exptrackr:exptrackr@localhost:5432/exptrackr

# Secret used to sign express-session cookies and to derive the
# AES-256 key that encrypts email bodies at rest (Server/crypto.js).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=CHANGE_ME_generate_a_long_random_string

# ── SERVER ────────────────────────────────────────

# Runtime environment.  "development" skips the client-build check so you can
# run the API server alone and use CRA's dev server for the frontend.
NODE_ENV=development

# Port the Express server listens on (default: 5000).
PORT=5000

# Bind address for the Express server (default: 0.0.0.0).
HOST=0.0.0.0

# ── DATABASE ──────────────────────────────────────

# Absolute or repo-relative path to the SQLite file.
# The directory is created automatically on startup if it doesn't exist.
# Default: Database/transactions.db (relative to repo root)
# SQLITE_PATH=Database/transactions.db

# ── PYTHON ────────────────────────────────────────

# Python binary used to call PDF parser scripts.
# On most Linux/macOS systems this is "python3".
# On Windows (no Docker) it may be just "python".
# Default: python3
# PYTHON_CMD=python3

# ── EMAIL INGESTION (optional) ───────────────────

# Gmail address to fetch bank transaction emails from via IMAP.
# If unset, the email extraction UI tab is disabled gracefully.
# EMAIL_USER=you@gmail.com

# Gmail App Password (not your account password).
# Generate one at: https://myaccount.google.com/apppasswords
# EMAIL_PASS=xxxx xxxx xxxx xxxx

# ── INBOUND EMAIL FORWARDING (optional) ──────────

# Secret token for the inbound-email webhook endpoint (/api/inbound-email).
# Also used as the root key for AES-256 encryption of stored email bodies.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If unset, the forwarding address feature and email body encryption are disabled.
# INBOUND_EMAIL_SECRET=CHANGE_ME_another_random_secret

# Domain used to build per-user forwarding addresses (inbox+<token>@<domain>).
# Default: exptracker.app — override if you're hosting under your own domain.
# FORWARDING_DOMAIN=exptracker.app

# ── AI CHAT (optional) ────────────────────────────

# OpenAI API key for the AI chat feature (/api/chat).
# If unset, the AI chat panel returns 503 gracefully.
# Provided automatically on Replit via the OpenAI integration.
# AI_INTEGRATIONS_OPENAI_API_KEY=sk-...

# Override the OpenAI API base URL (e.g. for Azure OpenAI or a local proxy).
# Default: https://api.openai.com/v1
# AI_INTEGRATIONS_OPENAI_BASE_URL=https://api.openai.com/v1

# ── FRONTEND (optional) ───────────────────────────

# Override the API base URL used by the React frontend.
# Only needed when the frontend and backend run on different origins.
# When using CRA dev server (port 3000) this is set automatically by api.js.
# REACT_APP_API_URL=http://localhost:5000
