{
  "name": "expensetracker-root",
  "private": true,
  "scripts": {
    "install:server": "npm --prefix Server install",
    "install:client": "npm --prefix client install --legacy-peer-deps",
    "postinstall": "npm run install:server && npm run install:client",
    "init:db": "node scripts/init-db.js",
    "build": "npm --prefix client run build",
    "replit:build": "npm install && node scripts/install-python-deps.js && npm run build && npm run verify:deploy",
    "start": "node scripts/start-production.js",
    "start:server": "npm --prefix Server run start",
    "verify:deploy": "node scripts/verify-deploy.js"
  },
  "dependencies": {
    "@types/connect-pg-simple": "^7.0.3",
    "@types/express-session": "^1.19.0",
    "@types/memoizee": "^0.4.12",
    "@types/passport": "^1.0.17",
    "connect-pg-simple": "^10.0.0",
    "cors": "^2.8.6",
    "drizzle-zod": "^0.8.3",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "memoizee": "^0.4.17",
    "openai": "^6.33.0",
    "openid-client": "^6.8.4",
    "p-limit": "^7.3.0",
    "p-retry": "^7.1.1",
    "passport": "^0.7.0",
    "sqlite3": "^6.0.1",
    "zod": "^4.3.6",
    "zod-validation-error": "^5.0.0"
  },
  "overrides": {
    "nth-check": ">=2.0.1",
    "serialize-javascript": "7.0.5",
    "underscore": "1.13.8",
    "node-forge": "1.4.0"
  }
}
